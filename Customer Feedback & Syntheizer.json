      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "models/gemini-3.1-flash-lite",
          "cachedResultName": "models/gemini-3.1-flash-lite"
        },
        "messages": {
          "values": [
            {
              "content": "Analyze this ONE customer review.\n\nCustomer review:\n{{ $json.reviewText }}\n\nReturn ONLY valid JSON. Do not include markdown, explanation, or any other text.\n\n{\n  \"sentiment\": \"Positive\",\n  \"complaint\": \"\",\n  \"featureRequest\": \"\"\n}\n\nRules:\n- sentiment must be only Positive, Negative, or Neutral.\n- complaint should contain the customer's complaint, or \"\" if there is no complaint.\n- featureRequest should contain the customer's requested feature/improvement, or \"\" if there is none.\nconst input = $input.first().json;\n\n// Get AI response\nlet output = input.parts?.[0]?.text ?? \"\";\n\n// Clean the response\noutput = output\n  .replace(/```json/gi, \"\")\n  .replace(/```/g, \"\")\n  .trim();\n\n// Extract values directly from the AI response\nconst sentiment =\n  output.match(/\"sentiment\"\\s*:\\s*\"([^\"]*)\"/i)?.[1] ?? \"\";\n\nconst complaint =\n  output.match(/\"complaint\"\\s*:\\s*\"([^\"]*)\"/i)?.[1] ?? \"\";\n\nconst featureRequest =\n  output.match(/\"featureRequest\"\\s*:\\s*\"([^\"]*)\"/i)?.[1] ?? \"\";\n\nreturn [\n  {\n    json: {\n      reviewId: input.reviewId ?? \"\",\n      sentiment,\n      complaint,\n      featureRequest\n    }\n  }\n];"
            }
          ]
        },
        "jsonOutput": true,
        "builtInTools": {},
        "options": {}
      },
