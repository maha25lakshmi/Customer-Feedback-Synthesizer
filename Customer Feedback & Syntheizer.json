    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst output = input.content?.parts?.[0]?.text ?? \"\";\n\nlet data = {};\n\ntry {\n  data = JSON.parse(output);\n} catch (error) {\n  throw new Error(\"Invalid JSON: \" + output);\n}\n\nreturn [\n  {\n    json: {\n      ...input,\n      reviewId: $('Prepare Review').item.json.reviewId ?? \"\",\n      sentiment: data.sentiment ?? \"\",\n      complaint: data.complaint ?? \"\",\n      featureRequest: data.featureRequest ?? \"\"\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1232,
        0
      ],
      "id": "51f6e39a-5063-47ad-b263-00e43c3a8c64",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const rating = Number(item.json.rating);\n\n  let sentiment;\n\n  if (rating >= 4) {\n    sentiment = \"Positive\";\n  } else if (rating <= 2) {\n    sentiment = \"Negative\";\n  } else {\n    sentiment = \"Neutral\";\n  }\n\n  return {\n    json: {\n      ...item.json,\n      sentiment\n    }\n  };\n});"
      },
